# Zenward Platform — required environment variables (names only, no values).
# Copy to .env.local and fill in real local-development values — .env.local
# is gitignored (.gitignore: `.env*`) and must never be committed.
#
# The three NEXT_PUBLIC_* values are safe for the browser — the publishable
# key relies entirely on RLS/RPC authorization, never a service-role/secret
# key (docs/security/application-auth-boundary.md).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=

# --- Transactional email (server-only; NOT NEXT_PUBLIC_) --------------------
# Used to send the DRIVER INVITATION EMAIL (src/lib/email/). These are read
# only in server code and must never be exposed to the browser bundle.
#
# Provider: Resend (https://resend.com). Nemryn is the standard platform
# sender for every organization — there is no per-tenant sender domain.
# The organization's own name still appears dynamically in the email
# subject/body; only the technical "From" is fixed to Nemryn. (Custom
# tenant sending domains are a deferred, future paid white-label
# capability — not implemented.) Leave both blank for local development —
# with no key set and NODE_ENV!=production the app logs the rendered email
# (including the /join link) to the server console instead of sending. In
# staging/production, set both:
#   RESEND_API_KEY  — a Resend API key (starts with "re_")
#   EMAIL_FROM      — Nemryn's own verified sender, e.g.
#                     "Nemryn <notifications@nemryn.com>"
RESEND_API_KEY=
EMAIL_FROM=

# --- Public tenant-website intake (server-only; NOT NEXT_PUBLIC_) -----------
# P1-PILOT-S4B. Used ONLY by src/lib/public-intake/website-intake.ts (via
# src/lib/supabase/service-role-server.ts) to invoke
# submit_public_transportation_request and
# check_and_record_public_intake_rate_limit — the two functions this
# migration deliberately restricts to `service_role` only, closing the
# direct-anon-RPC bypass P1-PILOT-S4A's own report flagged. This key
# BYPASSES ROW LEVEL SECURITY ENTIRELY for whatever it is used to call — it
# must NEVER be read anywhere outside src/lib/supabase/service-role-
# server.ts, never returned in any response, never logged, never given to
# a client component, and never prefixed NEXT_PUBLIC_. For local
# development, use the value `supabase status -o env` prints for
# SERVICE_ROLE_KEY (Supabase's own fixed, publicly-documented local-dev
# demo key — identical on every local install, not a real secret). In
# staging/production this MUST be the project's own real service-role key,
# configured directly in the hosting platform's environment variables,
# never committed to this repository.
SUPABASE_SERVICE_ROLE_KEY=

# P1-COMM-D3 (optional). Dedicated public hosted-form origin, e.g. https://request.nemryn.com. When set, operators copy
# <origin>/<publicKey> links and that host serves ONLY the hosted request form (every other path 404s). Leave empty until
# the domain is added to the Vercel project and DNS points at it; https://app.nemryn.com/request/<publicKey> keeps working.
REQUEST_FORM_ORIGIN=
# P1-COMM-D3 (optional). Address that receives "Request setup help" emails from Website Requests (a mailto handoff;
# nothing is stored). Leave empty to show the help panel without a mail link.
SETUP_HELP_EMAIL=
