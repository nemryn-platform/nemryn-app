# Zenward Platform — required environment variables (names only, no values).
# Copy to .env.local and fill in real local-development values — .env.local
# is gitignored (.gitignore: `.env*`) and must never be committed.
#
# The three NEXT_PUBLIC_* values are safe for the browser — the publishable
# key relies entirely on RLS/RPC authorization, never a service-role/secret
# key (docs/security/application-auth-boundary.md).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=

# --- Transactional email (server-only; NOT NEXT_PUBLIC_) --------------------
# Used to send the DRIVER INVITATION EMAIL (src/lib/email/). These are read
# only in server code and must never be exposed to the browser bundle.
#
# Provider: Resend (https://resend.com). Nemryn is the standard platform
# sender for every organization — there is no per-tenant sender domain.
# The organization's own name still appears dynamically in the email
# subject/body; only the technical "From" is fixed to Nemryn. (Custom
# tenant sending domains are a deferred, future paid white-label
# capability — not implemented.) Leave both blank for local development —
# with no key set and NODE_ENV!=production the app logs the rendered email
# (including the /join link) to the server console instead of sending. In
# staging/production, set both:
#   RESEND_API_KEY  — a Resend API key (starts with "re_")
#   EMAIL_FROM      — Nemryn's own verified sender, e.g.
#                     "Nemryn <notifications@nemryn.com>"
RESEND_API_KEY=
EMAIL_FROM=
